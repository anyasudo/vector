from __future__ import annotations
import functools
import json
import time
from abc import ABC, abstractmethod
from typing import Protocol, Any, Callable


def log_calls(method: Callable) -> Callable:
    @functools.wraps(method)
    def wrapper(self: Any, *args: Any, **kwargs: Any) -> Any:
        class_name = type(self).__name__
        method_name = method.__name__
        print(f"{class_name}.{method_name} начинается")
        
        start = time.perf_counter()
        result = method(self, *args, **kwargs)
        elapsed = time.perf_counter() - start
        
        print(f"{class_name}.{method_name} выполнился за {elapsed:.6f} сек\n")
        return result
    return wrapper


class Report:
    __slots__ = ("title", "columns", "_rows")

    def __init__(self, title: str, columns: list[str]) -> None:
        self.title: str = title
        self.columns: list[str] = list(columns)
        self._rows: list[dict[str, str]] = []

    def add_row(self, row: dict[str, Any]) -> None:
        if set(row.keys()) != set(self.columns):
            raise ValueError(f"Ожидались ключи {self.columns}, получено {list(row.keys())}")
        self._rows.append({col: str(row[col]) for col in self.columns})

    def rows(self) -> list[dict[str, str]]:
        return list(self._rows)

    @property
    def rows_count(self) -> int:
        return len(self._rows)

    def __str__(self) -> str:
        return f"Отчёт '{self.title}' ({self.rows_count} строки, колонки: {', '.join(self.columns)})"

    def __repr__(self) -> str:
        return f"Report(title={self.title!r}, columns={self.columns!r})"


class IReportExporter(ABC):
    __slots__ = ()

    @abstractmethod
    def export(self, report: Report) -> str:
        ...


class JsonExporter(IReportExporter):
    __slots__ = ()

    @log_calls
    def export(self, report: Report) -> str:
        data = {"title": report.title, "columns": report.columns, "rows": report.rows()}
        return json.dumps(data, ensure_ascii=False, indent=2)


class CsvExporter(IReportExporter):
    __slots__ = ()

    @log_calls
    def export(self, report: Report) -> str:
        lines = [";".join(report.columns)]
        for row in report.rows():
            lines.append(";".join(row[col] for col in report.columns))
        return "\n".join(lines)


class MarkdownExporter(IReportExporter):
    __slots__ = ()

    @log_calls
    def export(self, report: Report) -> str:
        header = "| " + " | ".join(report.columns) + " |"
        sep = "| " + " | ".join("---" for _ in report.columns) + " |"
        lines = [header, sep]
        for row in report.rows():
            lines.append("| " + " | ".join(row[col] for col in report.columns) + " |")
        return "\n".join(lines)


class Saver(Protocol):
    def save(self, path: str, content: str) -> None:
        ...


class FileSaver:
    __slots__ = ()

    def save(self, path: str, content: str) -> None:
        with open(path, "w", encoding="utf-8") as f:
            f.write(content)


class ConsoleSaver:
    __slots__ = ()

    def save(self, path: str, content: str) -> None:
        print(content)


class MemorySaver:
    __slots__ = ("storage",)

    def __init__(self) -> None:
        self.storage: dict[str, str] = {}

    def save(self, path: str, content: str) -> None:
        self.storage[path] = content


class ReportPipeline:
    __slots__ = ("_exporter", "_saver")

    def __init__(self, exporter: IReportExporter, saver: Saver) -> None:
        self._exporter = exporter
        self._saver = saver

    def run(self, report: Report, path: str) -> None:
        content = self._exporter.export(report)
        self._saver.save(path, content)


if __name__ == "__main__":
    rep = Report("Продажи", ["date", "product", "amount"])
    rep.add_row({"date": "2026-11-01", "product": "Мышь", "amount": 1500})
    rep.add_row({"date": "2026-11-02", "product": "Коврик", "amount": 500})

    mem_saver = MemorySaver()
    ReportPipeline(JsonExporter(), mem_saver).run(rep, "data.json")
    print("В памяти сохранено:\n", mem_saver.storage["data.json"])
    
    ReportPipeline(MarkdownExporter(), ConsoleSaver()).run(rep, "console")

    try:
        rep.add_row({"date": "2026-11-03", "product": "Клавиатура"})
    except ValueError as e:
        print("\nПроверка ошибки:", e)

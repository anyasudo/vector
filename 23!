import math


class Point3d:
    _total_points_count = 0

    def __init__(self, x, y, z):
        self.x = float(x)
        self.y = float(y)
        self.z = float(z)
        Point3d._total_points_count += 1

    def __str__(self):
        return f"({self.x:.2f}, {self.y:.2f}, {self.z:.2f})"

    def __repr__(self):
        return f"Point3d(x={self.x:.2f}, y={self.y:.2f}, z={self.z:.2f})"

    def distance_to(self, other):
        return math.sqrt(
            (other.x - self.x) ** 2
            + (other.y - self.y) ** 2
            + (other.z - self.z) ** 2
        )

    @classmethod
    def origin(cls):
        return cls(0.0, 0.0, 0.0)

    @classmethod
    def clone(cls, point):
        return cls(point.x, point.y, point.z)

    @classmethod
    def from_polar(cls, r, theta_degrees, z=0.0):
        rad = math.radians(theta_degrees)
        return cls(r * math.cos(rad), r * math.sin(rad), z)

    @staticmethod
    def distance_between(p1, p2):
        return math.sqrt(
            (p2[0] - p1[0]) ** 2
            + (p2[1] - p1[1]) ** 2
            + (p2[2] - p1[2]) ** 2
        )


class Vector3d:
    def __init__(self, x, y, z):
        self.x = float(x)
        self.y = float(y)
        self.z = float(z)

    def __str__(self):
        return f"({self.x:.2f}, {self.y:.2f}, {self.z:.2f})"

    def __repr__(self):
        return f"Vector3d(x={self.x:.2f}, y={self.y:.2f}, z={self.z:.2f})"

    @classmethod
    def from_points(cls, start, end):
        return cls(end.x - start.x, end.y - start.y, end.z - start.z)

    def _extract(self, other):
        if isinstance(other, Vector3d):
            return other.x, other.y, other.z
        if isinstance(other, (int, float)):
            return float(other), float(other), float(other)
        raise TypeError("Операнд должен быть объектом Vector3d или числом")

    def _exact_length(self):
        return math.sqrt(self.x ** 2 + self.y ** 2 + self.z ** 2)

    def __eq__(self, other):
        if isinstance(other, Vector3d):
            return (self.x, self.y, self.z) == (other.x, other.y, other.z)
        return False

    def __lt__(self, other):
        return self._exact_length() < other._exact_length()

    def __gt__(self, other):
        return self._exact_length() > other._exact_length()

    def __add__(self, other):
        x, y, z = self._extract(other)
        return Vector3d(self.x + x, self.y + y, self.z + z)

    __radd__ = __add__

    def __sub__(self, other):
        x, y, z = self._extract(other)
        return Vector3d(self.x - x, self.y - y, self.z - z)

    def __rsub__(self, other):
        x, y, z = self._extract(other)
        return Vector3d(x - self.x, y - self.y, z - self.z)

    def __mul__(self, other):
        x, y, z = self._extract(other)
        return Vector3d(self.x * x, self.y * y, self.z * z)

    __rmul__ = __mul__

    def __truediv__(self, other):
        x, y, z = self._extract(other)
        return Vector3d(self.x / x, self.y / y, self.z / z)

    def __rtruediv__(self, other):
        x, y, z = self._extract(other)
        return Vector3d(x / self.x, y / self.y, z / self.z)

    def __iadd__(self, other):
        x, y, z = self._extract(other)
        self.x += x
        self.y += y
        self.z += z
        return self

    def __isub__(self, other):
        x, y, z = self._extract(other)
        self.x -= x
        self.y -= y
        self.z -= z
        return self

    def __imul__(self, other):
        x, y, z = self._extract(other)
        self.x *= x
        self.y *= y
        self.z *= z
        return self

    def __itruediv__(self, other):
        x, y, z = self._extract(other)
        self.x /= x
        self.y /= y
        self.z /= z
        return self

    def __matmul__(self, other):
        return Vector3d(
            self.y * other.z - self.z * other.y,
            self.z * other.x - self.x * other.z,
            self.x * other.y - self.y * other.x,
        )

    @staticmethod
    def is_collinear(a, b, c):
        zero = Vector3d(0, 0, 0)
        return (a @ b) == zero and (b @ c) == zero and (a @ c) == zero

    @staticmethod
    def is_complanar(a, b, c):
        mixed = (
            a.x * (b.y * c.z - b.z * c.y)
            - a.y * (b.x * c.z - b.z * c.x)
            + a.z * (b.x * c.y - b.y * c.x)
        )
        return math.isclose(mixed, 0.0, abs_tol=1e-9)

    def __len__(self):
        return int(self._exact_length())

    def __getitem__(self, key):
        if key in (0, "x"):
            return self.x
        if key in (1, "y"):
            return self.y
        if key in (2, "z"):
            return self.z
        raise IndexError("Индекс должен быть 0, 1, 2 или 'x', 'y', 'z'")

    def __iter__(self):
        yield self.x
        yield self.y
        yield self.z



        Point3d._total_points_count += 1

    def __str__(self) -> str:
        return f"({self.x:.2f}, {self.y:.2f}, {self.z:.2f})"

    def __repr__(self) -> str:
        return f"Point3d(x={self.x:.2f}, y={self.y:.2f}, z={self.z:.2f})"

    def distance_to(self, other: "Point3d") -> float:
        return math.sqrt(
            (other.x - self.x) ** 2
            + (other.y - self.y) ** 2
            + (other.z - self.z) ** 2
        )

    @classmethod
    def origin(cls) -> "Point3d":
        return cls(0.0, 0.0, 0.0)

    @classmethod
    def clone(cls, point: "Point3d") -> "Point3d":
        return cls(point.x, point.y, point.z)

    @classmethod
    def from_polar(cls, r: float, theta_degrees: float, z: float = 0.0) -> "Point3d":
        rad: float = math.radians(theta_degrees)
        return cls(r * math.cos(rad), r * math.sin(rad), z)

    @staticmethod
    def distance_between(
        p1: tuple[float, float, float],
        p2: tuple[float, float, float],
    ) -> float:
        return math.sqrt(
            (p2[0] - p1[0]) ** 2
            + (p2[1] - p1[1]) ** 2
            + (p2[2] - p1[2]) ** 2

        mixed: float = (
            a.x * (b.y * c.z - b.z * c.y)
            - a.y * (b.x * c.z - b.z * c.x)
            + a.z * (b.x * c.y - b.y * c.x)
        )
        return math.isclose(mixed, 0.0, abs_tol=1e-9)

    def __len__(self) -> int:
        return int(self._exact_length())

    def __getitem__(self, key: Union[int, str]) -> float:
        if key in (0, "x"):
            return self.x
        if key in (1, "y"):
            return self.y
        if key in (2, "z"):
            return self.z
        raise IndexError("Индекс должен быть 0, 1, 2 или 'x', 'y', 'z'")


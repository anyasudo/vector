from typing import Protocol, List
from collections import deque

# ==========================================
# 1. Протокол для приемников (Утиная типизация)
# ==========================================
class DataReceiver(Protocol):
    def consume(self, metric_name: str, current_value: float, trend: str) -> None:
        ...

# ==========================================
# 2. Диспетчер потока данных
# ==========================================
class DataStream:
    def __init__(self, history_size: int = 3) -> None:
        # deque(maxlen=N) автоматически удаляет старые элементы при превышении длины
        self.history: deque[float] = deque(maxlen=history_size)
        self.receivers: List[DataReceiver] = []

    def __rshift__(self, receiver: DataReceiver) -> 'DataStream':
        """Магический метод >> для подключения приемника (stream >> receiver)"""
        if receiver not in self.receivers:
            self.receivers.append(receiver)
        return self  # Возвращаем self для цепочек (stream >> a >> b)

    def __lshift__(self, receiver: DataReceiver) -> 'DataStream':
        """Магический метод << для отключения приемника (stream << receiver)"""
        if receiver in self.receivers:
            self.receivers.remove(receiver)
        return self

    def broadcast(self, metric_name: str, new_value: float) -> None:
        """Анализирует тренд и рассылает данные всем подписчикам"""
        trend = "STABLE"
        
        # Если в истории уже есть значения, сравниваем с последним
        if self.history:
            prev_value = self.history[-1]
            if new_value > prev_value:
                trend = "UP"
            elif new_value < prev_value:
                trend = "DOWN"
        
        # Добавляем новое значение в историю
        self.history.append(new_value)

        # Рассылаем данные
        for receiver in self.receivers:
            receiver.consume(metric_name, new_value, trend)

# ==========================================
# 3. Компоненты-приемники
# ==========================================
class ConsoleDashboard:
    def consume(self, metric_name: str, current_value: float, trend: str) -> None:
        print(f"[Панель] Метрика: {metric_name} | Значение: {current_value} | Направление: {trend}")

class ThresholdGuard:
    def __init__(self, limit: float) -> None:
        self.limit = limit

    def consume(self, metric_name: str, current_value: float, trend: str) -> None:
        # Вард срабатывает только если значение выше лимита И оно продолжает расти
        if current_value > self.limit and trend == "UP":
            print(f"!!! [АЛЕРТ] {metric_name} превысил предел {self.limit}! Текущее: {current_value} (Тренд: {trend}) !!!")

# ==========================================
# 4. Источник данных с авто-апдейтом (Сеттер)
# ==========================================
class MetricTracker:
    def __init__(self, metric_name: str) -> None:
        self.metric_name = metric_name
        self._load: float = 0.0  # Приватное поле для хранения значения
        self.stream = DataStream()

    @property
    def load(self) -> float:
        return self._load

    @load.setter
    def load(self, new_value: float) -> None:
        """Сеттер: при изменении значения автоматически запускает рассылку"""
        self._load = new_value
        self.stream.broadcast(self.metric_name, new_value)


# ==========================================
# Демонстрация (Тестирование системы)
# ==========================================
if __name__ == "__main__":
    print("--- 1. Создание системы ---")
    # 1. Создаем трекер
    cpu_tracker = MetricTracker("CPU_Load")
    
    # 2. Создаем приемники
    dashboard = ConsoleDashboard()
    guard = ThresholdGuard(limit=80.0)
    
    # Подключаем их к потоку трекера красивым синтаксисом (оператор >>)
    cpu_tracker.stream >> dashboard >> guard
    
    print("\n--- 2. Симуляция изменения нагрузки ---")
    print("\nПодаем 50:")
    cpu_tracker.load = 50  # Срабатывает @load.setter -> broadcast -> вывод

    print("\nПодаем 75:")
    cpu_tracker.load = 75

    print("\nПодаем 85 (Должен сработать вард, так как > 80 и UP):")
    cpu_tracker.load = 85

    print("\nПодаем 82 (Вард молчит, так как > 80, но тренд DOWN - нагрузка падает):")
    cpu_tracker.load = 82

    print("\nПодаем 88 (Снова срабатывает вард, тренд UP):")
    cpu_tracker.load = 88

    print("\n--- 3. Отключение варда ---")
    # Отключаем ThresholdGuard оператором <<
    cpu_tracker.stream << guard
    
    print("\nПодаем 95 (Выведется только Панель, вард больше не слушает):")
    cpu_tracker.load = 95

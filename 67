import json
import time
import functools
from abc import ABC, abstractmethod
from typing import Protocol, Any, Callable

# ---------------------------------------------------------
# 1. Декоратор для замеров времени
# ---------------------------------------------------------
def log_calls(method: Callable) -> Callable:
    """Оборачивает метод, логируя его имя, класс и время работы."""
    @functools.wraps(method)
    def wrapper(self: Any, *args: Any, **kwargs: Any) -> Any:
        cls_name = self.__class__.__name__
        func_name = method.__name__
        
        print(f"[{cls_name}.{func_name}] -> старт")
        t_start = time.perf_counter()
        
        result = method(self, *args, **kwargs)
        
        t_end = time.perf_counter()
        print(f"[{cls_name}.{func_name}] -> завершено за {t_end - t_start:.5f} сек")
        
        return result
    return wrapper

# ---------------------------------------------------------
# 2. Класс для хранения данных отчета
# ---------------------------------------------------------
class Report:
    __slots__ = ("title", "columns", "_rows")

    def __init__(self, title: str, columns: list[str]) -> None:
        self.title = title
        self.columns = columns
        self._rows: list[dict[str, str]] = []

    def add_row(self, row: dict[str, Any]) -> None:
        # Проверяем, что переданы именно те колонки, которые нужны
        if set(row.keys()) != set(self.columns):
            raise ValueError(f"Ошибка! Ожидались колонки: {self.columns}, получено: {list(row.keys())}")
        
        # Переводим любые значения (например, числа) в строки
        stringified_row = {key: str(val) for key, val in row.items()}
        self._rows.append(stringified_row)

    def rows(self) -> list[dict[str, str]]:
        return self._rows.copy()

    @property
    def rows_count(self) -> int:
        return len(self._rows)

    def __str__(self) -> str:
        return f"Отчёт '{self.title}' ({self.rows_count} строки, колонки: {', '.join(self.columns)})"

    def __repr__(self) -> str:
        return f"Report(title={self.title!r}, columns={self.columns!r})"

# ---------------------------------------------------------
# 3. Абстрактный экспортер и его реализации (Наследование)
# ---------------------------------------------------------
class IReportExporter(ABC):
    __slots__ = ()

    @abstractmethod
    def export(self, report: Report) -> str:
        pass


class JsonExporter(IReportExporter):
    __slots__ = ()

    @log_calls
    def export(self, report: Report) -> str:
        payload = {
            "title": report.title,
            "columns": report.columns,
            "rows": report.rows()
        }
        return json.dumps(payload, ensure_ascii=False, indent=2)


class CsvExporter(IReportExporter):
    __slots__ = ()

    @log_calls
    def export(self, report: Report) -> str:
        # Заголовок
        result = [";".join(report.columns)]
        # Данные
        for row in report.rows():
            result.append(";".join(row[c] for c in report.columns))
        return "\n".join(result)


class MarkdownExporter(IReportExporter):
    __slots__ = ()

    @log_calls
    def export(self, report: Report) -> str:
        header = f"| {' | '.join(report.columns)} |"
        divider = f"| {' | '.join(['---'] * len(report.columns))} |"
        
        result = [header, divider]
        for row in report.rows():
            result.append(f"| {' | '.join(row[c] for c in report.columns)} |")
            
        return "\n".join(result)

# ---------------------------------------------------------
# 4. Протокол для сохранения (Утиная типизация)
# ---------------------------------------------------------
class Saver(Protocol):
    def save(self, path: str, content: str) -> None:
        ...

# Реализации не наследуются от Saver! Им достаточно просто иметь метод save.
class FileSaver:
    __slots__ = ()
    
    def save(self, path: str, content: str) -> None:
        with open(path, "w", encoding="utf-8") as file:
            file.write(content)

class ConsoleSaver:
    __slots__ = ()
    
    def save(self, path: str, content: str) -> None:
        print(f"\n--- Вывод файла: {path} ---")
        print(content)

class MemorySaver:
    __slots__ = ("storage",)
    
    def __init__(self) -> None:
        self.storage: dict[str, str] = {}

    def save(self, path: str, content: str) -> None:
        self.storage[path] = content

# ---------------------------------------------------------
# 5. Главный сборщик (Пайплайн)
# ---------------------------------------------------------
class ReportPipeline:
    __slots__ = ("_exporter", "_saver")

    def __init__(self, exporter: IReportExporter, saver: Saver) -> None:
        self._exporter = exporter
        self._saver = saver

    def run(self, report: Report, path: str) -> None:
        # 1. Экспортер превращает объект в текст
        formatted_text = self._exporter.export(report)
        # 2. Сейвер берет этот текст и сохраняет
        self._saver.save(path, formatted_text)

